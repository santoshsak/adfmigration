	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-onprem-migr"
		},
		"LS_ADLS_GEN2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_GEN2'"
		},
		"LS_SQL_ONPREM_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_ONPREM'"
		},
		"LS_ADLS_GEN2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stonpremmigrationn.dfs.core.windows.net/"
		},
		"LS_SQL_ONPREM_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "SANTOSH\\SQLEXPRESS"
		},
		"LS_SQL_ONPREM_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "JLL"
		},
		"LS_SQL_ONPREM_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "SANTOSH\\lenovo"
		}
	},
